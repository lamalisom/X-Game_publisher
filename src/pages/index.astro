---
import Layout from '../layouts/Layout.astro';
import AffiliateCard from '../components/AffiliateCard.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import AdSense from '../components/AdSense.astro';
import NewsletterBar from '../components/NewsletterBar.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const heroPost = sortedPosts[0];
const subFeaturedPosts = sortedPosts.slice(1, 4);
const eventPosts = sortedPosts.filter(p => p.data.category === 'EVENT' || p.data.topic_type === 'EVENT' || p.data.event_info);
const spotPosts = sortedPosts.filter(p => p.data.category === 'SPOT' || p.data.topic_type === 'SPOT' || p.data.spot_info);
const athletePosts = sortedPosts.filter(p => p.data.category === 'ATHLETE' || p.data.topic_type === 'ATHLETE' || p.data.expert_info);
const trickPosts = sortedPosts.filter(p => p.data.category === 'TRICKS' || p.data.category === 'SAFETY' || p.data.topic_type === 'SAFETY' || p.data.topic_type === 'TIPS');

// Fallback if collections are smaller than expected
const latestArticles = sortedPosts.slice(0, 8);
---

<Layout title="xGame Radar Magazine | 全球極限運動熱血前線">
  
  <!-- Hero Section (Cyber Dark + Neon Orange Extreme Sports Style) -->
  <section class="relative overflow-hidden bg-xblack border-b border-xborder py-8 lg:py-12">
    <!-- Glow effects -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-gradient-to-r from-xorange/20 via-red-600/10 to-xcyan/20 blur-[120px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      {heroPost ? (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
          
          <!-- Main Hero Card -->
          <div class="lg:col-span-8 flex flex-col justify-between rounded-3xl overflow-hidden border border-xborder bg-xcard relative group">
            <div class="relative h-[320px] sm:h-[420px] lg:h-[480px] w-full overflow-hidden">
              <img
                src={heroPost.data.cover_image}
                alt={heroPost.data.title}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 brightness-90"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-xblack via-xblack/40 to-transparent"></div>
              
              <!-- Badges -->
              <div class="absolute top-5 left-5 flex flex-wrap gap-2">
                <span class="px-3 py-1 rounded-full bg-xorange text-white text-xs font-black uppercase tracking-wider shadow-glow-orange">
                  🔥 今日頭條 COVER STORY
                </span>
                <span class="px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-cyan-400 text-xs font-bold border border-cyan-500/30">
                  {heroPost.data.category} · {heroPost.data.city_tag}
                </span>
              </div>

              <!-- Title & Meta -->
              <div class="absolute bottom-6 left-6 right-6 space-y-3">
                <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white leading-tight tracking-tight drop-shadow-md group-hover:text-xorange transition-colors">
                  <a href={`/posts/${heroPost.slug}`}>
                    {heroPost.data.title}
                  </a>
                </h1>
                {heroPost.data.subtitle && (
                  <p class="text-sm sm:text-base text-gray-300 line-clamp-2 max-w-3xl">
                    {heroPost.data.subtitle}
                  </p>
                )}
                <div class="flex items-center gap-4 text-xs text-gray-400 font-mono pt-1">
                  <span>✍️ {heroPost.data.author}</span>
                  <span>•</span>
                  <span>🗓️ {heroPost.data.date.toISOString().split('T')[0]}</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Secondary Hero Highlights (Right Sidebar) -->
          <div class="lg:col-span-4 flex flex-col justify-between space-y-4">
            <div class="p-4 rounded-2xl bg-gradient-to-br from-xorange/20 to-xdark border border-xorange/40 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-black text-xorange uppercase tracking-widest block">RADAR FAST PASS</span>
                <h3 class="text-sm font-bold text-white">加入 Telegram 社群即時獲取快訊</h3>
              </div>
              <a
                href="https://t.me/Una_next"
                target="_blank"
                rel="noopener noreferrer"
                class="px-3 py-2 rounded-xl bg-xorange hover:bg-xorange-hover text-white text-xs font-black shadow-glow-orange transition-all"
              >
                加入 ↗
              </a>
            </div>

            {subFeaturedPosts.map((post) => (
              <a
                href={`/posts/${post.slug}`}
                class="flex gap-4 p-3.5 rounded-2xl bg-xcard/80 border border-xborder hover:border-xorange/50 hover:bg-xcard transition-all group"
              >
                <img
                  src={post.data.cover_image}
                  alt={post.data.title}
                  class="w-24 h-24 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform"
                />
                <div class="flex flex-col justify-between py-0.5">
                  <div class="space-y-1">
                    <span class="text-[10px] font-bold text-xorange uppercase font-mono">
                      {post.data.category}
                    </span>
                    <h4 class="text-xs sm:text-sm font-bold text-white line-clamp-2 group-hover:text-xorange transition-colors">
                      {post.data.title}
                    </h4>
                  </div>
                  <span class="text-[10px] text-gray-500 font-mono">
                    {post.data.date.toISOString().split('T')[0]}
                  </span>
                </div>
              </a>
            ))}
          </div>

        </div>
      ) : (
        <div class="text-center py-20">
          <h2 class="text-2xl font-bold text-gray-400">目前尚無文章，即將自動生成...</h2>
        </div>
      )}

    </div>
  </section>

  <!-- Section 1: 🗓️ 未來 3-12 個月賽事雷達 (Upcoming Events Radar) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-xborder">
    <div class="flex items-center justify-between mb-8">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-cyan-400 animate-ping"></span>
          <span class="text-xs font-black text-cyan-400 uppercase tracking-widest font-mono">2026-2027 CALENDAR</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
          <span>🗓️ 未來 3-12 個月全球重大賽事雷達</span>
        </h2>
      </div>
      <a href="/events" class="text-xs font-bold text-cyan-400 hover:text-white flex items-center gap-1">
        <span>完整賽歷</span> →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {eventPosts.length > 0 ? (
        eventPosts.slice(0, 3).map((item) => (
          <div class="rounded-2xl bg-gradient-to-b from-xcard to-xdark border border-xborder p-5 flex flex-col justify-between hover:border-cyan-400/50 transition-all group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-cyan-400 text-[10px] font-black uppercase border border-cyan-500/30">
                  {item.data.event_info?.tier || 'World Tour Tier'}
                </span>
                <span class="text-[11px] font-mono text-gray-400">
                  📍 {item.data.event_info?.location || item.data.city_tag}
                </span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-cyan-400 transition-colors">
                <a href={`/posts/${item.slug}`}>{item.data.title}</a>
              </h3>
              <p class="text-xs text-gray-400 line-clamp-2">
                {item.data.subtitle || item.data.event_info?.dates}
              </p>
            </div>
            
            <div class="mt-4 pt-4 border-t border-xborder/50 flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-yellow-400">
                ⏰ {item.data.event_info?.dates || '近期開賽'}
              </span>
              <a href={`/posts/${item.slug}`} class="text-xs font-bold text-white hover:text-cyan-400">
                賽事詳情 →
              </a>
            </div>
          </div>
        ))
      ) : (
        <div class="col-span-3 p-6 rounded-2xl bg-xcard border border-xborder text-center text-gray-400 text-sm">
          賽事雷達每日由 AI 引擎檢測並同步更新 X Games, SLS, WSL, IFSC 最新日程。
        </div>
      )}
    </div>
  </section>

  <!-- Section 2: 🏆 頂級專家與選手檔案 + 🛹 極限場地導覽 (2 Columns) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-xborder">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      
      <!-- Column A: 🏆 焦點人物 (Experts & Athletes) -->
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>🏆 焦點專家與選手專題</span>
          </h2>
          <a href="/athletes" class="text-xs font-bold text-xorange hover:underline">查看全部 →</a>
        </div>

        <div class="space-y-4">
          {athletePosts.length > 0 ? (
            athletePosts.slice(0, 3).map((post) => (
              <a
                href={`/posts/${post.slug}`}
                class="flex items-center gap-4 p-4 rounded-2xl bg-xcard border border-xborder hover:border-xorange/50 transition-all group"
              >
                <img
                  src={post.data.cover_image}
                  alt={post.data.title}
                  class="w-20 h-20 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform"
                />
                <div class="flex-1 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded bg-xorange/20 text-xorange text-[10px] font-bold">
                      {post.data.category}
                    </span>
                    {post.data.expert_info?.country && (
                      <span class="text-[11px] text-gray-400">🌍 {post.data.expert_info.country}</span>
                    )}
                  </div>
                  <h3 class="text-sm font-bold text-white group-hover:text-xorange transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-gray-400 line-clamp-1">
                    {post.data.expert_info?.setup_breakdown || post.data.subtitle}
                  </p>
                </div>
              </a>
            ))
          ) : (
            <p class="text-xs text-gray-400">今日專家專訪更新中...</p>
          )}
        </div>
      </div>

      <!-- Column B: 🛹 熱門極限場地導覽 (Spots & Skateparks) -->
      <div class="space-y-6">
        <div class="flex items-center justify-between">
          <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>🛹 全球 & 亞洲場地導覽</span>
          </h2>
          <a href="/spots" class="text-xs font-bold text-cyan-400 hover:underline">查看全部 →</a>
        </div>

        <div class="space-y-4">
          {spotPosts.length > 0 ? (
            spotPosts.slice(0, 3).map((post) => (
              <a
                href={`/posts/${post.slug}`}
                class="flex items-center gap-4 p-4 rounded-2xl bg-xcard border border-xborder hover:border-cyan-400/50 transition-all group"
              >
                <img
                  src={post.data.cover_image}
                  alt={post.data.title}
                  class="w-20 h-20 rounded-xl object-cover flex-shrink-0 group-hover:scale-105 transition-transform"
                />
                <div class="flex-1 space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-400 text-[10px] font-bold">
                      {post.data.spot_info?.difficulty || 'All Levels'}
                    </span>
                    <span class="text-[11px] text-gray-400">📍 {post.data.spot_info?.location || post.data.city_tag}</span>
                  </div>
                  <h3 class="text-sm font-bold text-white group-hover:text-cyan-400 transition-colors">
                    {post.data.title}
                  </h3>
                  <p class="text-xs text-gray-400 line-clamp-1">
                    {post.data.spot_info?.best_season_or_hours || post.data.subtitle}
                  </p>
                </div>
              </a>
            ))
          ) : (
            <p class="text-xs text-gray-400">場地導覽更新中...</p>
          )}
        </div>
      </div>

    </div>
  </section>

  <!-- Section 3: 🛡️ 安全裝備評測 & 🎯 花式動作分解 (Trick Vault) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 border-b border-xborder">
    <div class="flex items-center justify-between mb-8">
      <div>
        <span class="text-xs font-black text-yellow-400 uppercase tracking-widest font-mono">SAFETY FIRST & PRO SKILLS</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white flex items-center gap-2">
          <span>🛡️ 安全裝備深度評測 & 花式技巧庫</span>
        </h2>
      </div>
      <a href="/tricks" class="text-xs font-bold text-yellow-400 hover:underline">
        瀏覽技巧庫 →
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {trickPosts.slice(0, 4).map((post) => (
        <a
          href={`/posts/${post.slug}`}
          class="rounded-2xl bg-xcard border border-xborder overflow-hidden flex flex-col justify-between hover:border-yellow-400/50 hover:shadow-lg transition-all group"
        >
          <div class="relative h-44 overflow-hidden">
            <img
              src={post.data.cover_image}
              alt={post.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute top-3 left-3">
              <span class="px-2 py-0.5 rounded-full bg-black/70 backdrop-blur-sm text-yellow-400 text-[10px] font-black border border-yellow-400/30">
                {post.data.topic_type}
              </span>
            </div>
          </div>
          <div class="p-4 space-y-2 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-sm font-bold text-white group-hover:text-yellow-400 transition-colors line-clamp-2">
                {post.data.title}
              </h3>
              <p class="text-xs text-gray-400 line-clamp-2 mt-1">
                {post.data.subtitle}
              </p>
            </div>
            <div class="pt-3 border-t border-xborder/50 text-[11px] font-mono text-gray-500 flex justify-between">
              <span>{post.data.category}</span>
              <span>閱讀指南 →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- AdSense Container -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSense />
  </div>

  <!-- Section 4: 🛒 Una's Amazon Gear Recommendations (Affiliate Showcase) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-xcard via-[#161822] to-xcard border border-xorange/40 shadow-2xl relative overflow-hidden">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="px-3 py-0.5 rounded-full bg-xorange text-white text-[10px] font-black uppercase tracking-wider">
              AMAZON AFFILIATE PICKS
            </span>
            <span class="text-xs text-gray-400 font-mono">官方直送門市</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white">
            Una's 極限裝備選購指南
          </h2>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed">
            嚴選全球專業極限選手同款裝備！從 ASTM 認證滑板頭盔、Pro-Tec 護具組、Vans Pro 滑板鞋到 GoPro 極限運動配件，透過專屬連結享直送優惠並支持雜誌營運。
          </p>
        </div>

        <a
          href="https://www.amazon.com/s?k=extreme+sports+gear+protective+helmet&tag=kait02bc-20"
          target="_blank"
          rel="nofollow noopener sponsored"
          class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-xorange to-red-600 hover:from-xorange-hover hover:to-red-500 text-white font-black text-sm shadow-glow-orange hover:scale-105 transition-all whitespace-nowrap"
        >
          探索 Amazon 專屬門市 →
        </a>
      </div>

      <!-- Quick Affiliate Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-8 pt-6 border-t border-xborder/50">
        <div class="p-4 rounded-xl bg-xdark/70 border border-xborder">
          <span class="text-[10px] font-mono text-xorange font-bold">🛹 滑板安全必備</span>
          <h4 class="text-xs font-bold text-white mt-1">Triple 8 / Pro-Tec 雙認證極限頭盔</h4>
          <p class="text-[11px] text-gray-400 mt-1">CPSC & ASTM 雙認證，抗衝擊高透氣 EPS 核心</p>
          <a
            href="https://www.amazon.com/s?k=skateboarding+helmet+triple+8+protec&tag=kait02bc-20"
            target="_blank"
            rel="nofollow noopener sponsored"
            class="text-[11px] font-bold text-xorange hover:underline block mt-2"
          >
            查看售價 →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-xdark/70 border border-xborder">
          <span class="text-[10px] font-mono text-cyan-400 font-bold">🚲 BMX / 街式護具</span>
          <h4 class="text-xs font-bold text-white mt-1">187 Killer Pads 專業級護膝護肘組</h4>
          <p class="text-[11px] text-gray-400 mt-1">職業選手首選，厚實海綿與快拆魔鬼氈設計</p>
          <a
            href="https://www.amazon.com/s?k=187+killer+pads+pro+knee&tag=kait02bc-20"
            target="_blank"
            rel="nofollow noopener sponsored"
            class="text-[11px] font-bold text-cyan-400 hover:underline block mt-2"
          >
            查看售價 →
          </a>
        </div>

        <div class="p-4 rounded-xl bg-xdark/70 border border-xborder">
          <span class="text-[10px] font-mono text-yellow-400 font-bold">📹 動作攝影必備</span>
          <h4 class="text-xs font-bold text-white mt-1">GoPro HERO 運動相機 & 極限配件組</h4>
          <p class="text-[11px] text-gray-400 mt-1">HyperSmooth 超強防手震，4K/120fps 慢動作捕捉</p>
          <a
            href="https://www.amazon.com/s?k=gopro+action+camera+extreme+sports&tag=kait02bc-20"
            target="_blank"
            rel="nofollow noopener sponsored"
            class="text-[11px] font-bold text-yellow-400 hover:underline block mt-2"
          >
            查看售價 →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- VIP Newsletter Subscription Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <NewsletterBar variant="full" />
  </div>

</Layout>
