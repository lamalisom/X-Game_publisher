---
import Layout from '../../layouts/Layout.astro';
import SpotMapbox from '../../components/SpotMapbox.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const spotArticles = allPosts
  .filter((p) => p.data.topic_type === 'SPOT' || p.data.spot_info !== undefined)
  .slice(0, 6);
---

<Layout
  title="📍 全球極限運動場地雷達庫 (Global Action Spots Radar) | xGame Radar"
  description="即時探索全球滑板場、碗池、衝浪浪點、攀岩抱石館與 BMX 泵道。附官方網站、Google Maps 導航與周邊預約。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <div class="rounded-3xl bg-gradient-to-r from-xcard via-xdark to-xcard border border-xborder p-6 sm:p-10 relative overflow-hidden">
      <div class="space-y-3 max-w-3xl relative z-10">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-xorange text-white text-xs font-black uppercase tracking-wider shadow-glow-orange">
            GLOBAL SPOTS RADAR
          </span>
          <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold font-mono">
            收錄頂級官方場地
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight uppercase">
          全球極限運動 <span class="text-xorange">場地探索庫</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-300 font-medium leading-relaxed">
          收錄全球街式滑板場（Skatepark）、巨型碗池（Bowl）、衝浪浪點（Surf Break）、抱石攀岩館（Climbing Gym）與 BMX 泵道。
        </p>
      </div>
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-xorange/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-black text-white flex items-center gap-2">
          <span>📡 實時衛星與點位視圖 (Live Spot Radar)</span>
        </h2>
        <span class="text-xs text-gray-400 font-mono hidden sm:inline-block">
          💡 點擊標記可開啟官方導航與官方網站
        </span>
      </div>

      <SpotMapbox />
    </section>

    <section class="space-y-6 pt-6">
      <div class="flex items-center justify-between border-b border-xborder pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>📍 精選場地官方攻略</span>
          </h2>
          <p class="text-xs text-gray-400 font-mono mt-1">設施規格、防護裝備與交通攻略</p>
        </div>
        <a href="/spots" class="text-xs font-bold text-xorange hover:underline font-mono">
          瀏覽全部列表 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {spotArticles.map((post) => (
          <article class="rounded-2xl bg-xcard border border-xborder hover:border-xorange/60 transition-all duration-300 overflow-hidden flex flex-col group hover:-translate-y-1 shadow-lg p-5 justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded-full bg-xorange/20 text-xorange text-[10px] font-bold font-mono border border-xorange/30">
                  {post.data.category || 'SPOT'}
                </span>
                <span class="text-[11px] text-gray-400 font-mono">
                  📍 {post.data.city_tag || 'Global'}
                </span>
              </div>
              <h3 class="text-base font-black text-white group-hover:text-xorange transition-colors leading-snug">
                {post.data.title}
              </h3>
            </div>
            
            <div class="pt-3 border-t border-xborder/60 flex items-center justify-between text-xs">
              <a href={} class="text-cyan-400 hover:underline font-bold">
                閱讀完整攻略 →
              </a>
              <a href={} target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg bg-emerald-600/20 text-emerald-300 font-bold hover:bg-emerald-600/40 border border-emerald-500/30">
                🌐 官方網站
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</Layout>
