---
import Layout from '../../layouts/Layout.astro';
import SpotMapbox from '../../components/SpotMapbox.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const spotArticles = allPosts
  .filter((p) => p.data.topic_type === 'SPOT' || p.data.spot_info !== undefined)
  .slice(0, 6);
---

<Layout
  title="🗺️ 全球極限運動互動地圖 (Global Extreme Spots Map) | xGame Radar"
  description="即時瀏覽全球頂級滑板場、碗池、衝浪浪點、抱石攀岩館與 BMX 泵道。支援 BBox 動態視窗載入、點狀聚類與路線導航。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <!-- Hero Header Banner -->
    <div class="rounded-3xl bg-gradient-to-r from-xcard via-xdark to-xcard border border-xborder p-6 sm:p-10 relative overflow-hidden">
      <div class="space-y-3 max-w-3xl relative z-10">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-cyan-500 text-black text-xs font-black uppercase tracking-wider shadow-glow-cyan">
            SPATIAL ENGINE
          </span>
          <span class="px-3 py-1 rounded-full bg-xorange/20 text-xorange text-xs font-bold font-mono">
            POSTGIS · MAPBOX CLUSTER · BBOX API
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight uppercase">
          全球極限運動 <span class="text-cyan-400">互動空間地圖</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-300 font-medium leading-relaxed">
          即時探索全球滑板場（Skatepark）、巨型碗池（Bowl）、世界級衝浪浪點（Surf Break）、攀岩抱石館（Climbing Gym）與 BMX 泵道（Pump Track）。支援拖曳縮放即時計算可視視窗內的所有點位。
        </p>
      </div>

      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- Interactive Mapbox Component -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-black text-white flex items-center gap-2">
          <span>📡 實時衛星與點位視圖 (Live Spot Radar)</span>
        </h2>
        <span class="text-xs text-gray-400 font-mono hidden sm:inline-block">
          💡 點擊聚類圓圈可放大，點擊單個點位可開啟導航與周邊預約
        </span>
      </div>

      <SpotMapbox />
    </section>

    <!-- Curated Spot Guides Section -->
    <section class="space-y-6 pt-6">
      <div class="flex items-center justify-between border-b border-xborder pb-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2">
            <span>📍 精選場地攻略與選手評測</span>
          </h2>
          <p class="text-xs text-gray-400 font-mono mt-1">深度圖文、設施規格、防護裝備與交通攻略</p>
        </div>
        <a href="/spots" class="text-xs font-bold text-xorange hover:underline font-mono">
          瀏覽全部場地列表 →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {spotArticles.map((post) => (
          <article class="rounded-2xl bg-xcard border border-xborder hover:border-xorange/60 transition-all duration-300 overflow-hidden flex flex-col group hover:-translate-y-1 shadow-lg">
            <a href={`/posts/${post.slug}/`} class="relative h-48 overflow-hidden bg-xdark">
              <img
                src={post.data.cover_image}
                alt={post.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-bold text-cyan-300 font-mono border border-white/10">
                {post.data.city_tag || 'SPOT'}
              </div>
            </a>
            <div class="p-5 flex-1 flex flex-col justify-between space-y-3">
              <div>
                <a href={`/posts/${post.slug}/`} class="block font-black text-base text-white group-hover:text-xorange transition-colors leading-snug line-clamp-2">
                  {post.data.title}
                </a>
                <p class="text-xs text-gray-400 line-clamp-2 mt-2 leading-relaxed">
                  {post.data.subtitle || post.data.spot_info?.location}
                </p>
              </div>

              {post.data.spot_info?.features && (
                <div class="flex flex-wrap gap-1 pt-2 border-t border-xborder/50">
                  {post.data.spot_info.features.slice(0, 2).map((feat: string) => (
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-xdark text-gray-300 border border-xborder/40">
                      ✓ {feat}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

  </div>
</Layout>
