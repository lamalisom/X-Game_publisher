---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

interface SpotItem {
  name: string;
  category: string;
  difficulty?: string;
  difficultyCn?: string;
  feeCn?: string;
  fee_type?: string;
  city?: string;
  country?: string;
  latitude?: number;
  longitude?: number;
  lat?: number;
  lng?: number;
  features?: string[];
  website?: string;
  surface_type?: string;
  environment?: string;
  badgeClass?: string;
  officialUrl?: string;
  navUrl?: string;
  hotelUrl?: string;
  gearUrl?: string;
  searchStr?: string;
  countryCode?: string;
  regionTag?: string;
}

// 🌍 全球多國經緯度與主要城市精準解析矩陣
function resolveLocation(lat: number, lng: number, rawCountry: string, rawCity: string, rawName: string) {
  const fullTxt = (rawCountry + ' ' + rawCity + ' ' + rawName).toLowerCase();
  
  // 1. 🇯🇵 日本 (Japan)
  if (fullTxt.includes('japan') || fullTxt.includes('日本') || /[\u3040-\u30ff]/.test(rawName) || (lat >= 24.0 && lat <= 46.0 && lng >= 122.0 && lng <= 154.0)) {
    let city = '日本地區';
    if (fullTxt.includes('東京') || fullTxt.includes('tokyo') || fullTxt.includes('shibuya') || fullTxt.includes('shinjuku') || (lat >= 35.53 && lat <= 35.89 && lng >= 139.34 && lng <= 139.92)) city = '東京 Tokyo';
    else if (fullTxt.includes('大阪') || fullTxt.includes('osaka') || fullTxt.includes('sakai') || (lat >= 34.40 && lat <= 34.88 && lng >= 135.32 && lng <= 135.75)) city = '大阪 Osaka';
    else if (fullTxt.includes('京都') || fullTxt.includes('kyoto') || (lat >= 34.85 && lat <= 35.32 && lng >= 135.55 && lng <= 135.88)) city = '京都 Kyoto';
    else if (fullTxt.includes('神奈川') || fullTxt.includes('kanagawa') || fullTxt.includes('yokohama') || fullTxt.includes('湘南') || (lat >= 35.12 && lat <= 35.60 && lng >= 139.00 && lng <= 139.75)) city = '神奈川/湘南 Kanagawa';
    else if (fullTxt.includes('埼玉') || fullTxt.includes('saitama') || (lat >= 35.75 && lat <= 36.28 && lng >= 138.90 && lng <= 139.90)) city = '埼玉 Saitama';
    else if (fullTxt.includes('千葉') || fullTxt.includes('chiba') || (lat >= 34.90 && lat <= 35.95 && lng >= 139.80 && lng <= 140.88)) city = '千葉 Chiba';
    else if (fullTxt.includes('北海道') || fullTxt.includes('hokkaido') || fullTxt.includes('sapporo') || (lat >= 41.30 && lat <= 45.60)) city = '北海道 Hokkaido';
    else if (fullTxt.includes('福岡') || fullTxt.includes('fukuoka') || (lat >= 33.20 && lat <= 33.95 && lng >= 130.00 && lng <= 131.05)) city = '福岡 Fukuoka';
    else if (fullTxt.includes('沖繩') || fullTxt.includes('okinawa') || (lat >= 26.00 && lat <= 27.00 && lng >= 127.50 && lng <= 128.50)) city = '沖繩 Okinawa';
    else if (fullTxt.includes('愛知') || fullTxt.includes('名古屋') || fullTxt.includes('nagoya')) city = '愛知/名古屋 Aichi';
    return { code: 'JP', country: '日本 Japan', flag: '🇯🇵', city };
  }

  // 2. 🇭🇰 香港 (Hong Kong)
  if (fullTxt.includes('hong kong') || fullTxt.includes('香港') || (lat >= 22.1 && lat <= 22.6 && lng >= 113.8 && lng <= 114.5)) {
    let city = '香港全區';
    if (fullTxt.includes('柴灣') || fullTxt.includes('chai wan')) city = '柴灣 Chai Wan';
    else if (fullTxt.includes('荔枝角') || fullTxt.includes('美孚') || fullTxt.includes('mei foo')) city = '荔枝角/美孚 Mei Foo';
    else if (fullTxt.includes('大浪灣') || fullTxt.includes('big wave')) city = '大浪灣 Big Wave Bay';
    else if (fullTxt.includes('獅子山') || fullTxt.includes('lion rock')) city = '獅子山 Lion Rock';
    else if (fullTxt.includes('觀塘') || fullTxt.includes('kwun tong')) city = '觀塘 Kwun Tong';
    else if (fullTxt.includes('將軍澳') || fullTxt.includes('tseung kwan o')) city = '將軍澳 TKO';
    return { code: 'HK', country: '香港 Hong Kong', flag: '🇭🇰', city };
  }

  // 3. 🇹🇼 台灣 (Taiwan)
  if (fullTxt.includes('taiwan') || fullTxt.includes('台灣') || fullTxt.includes('臺灣') || (lat >= 21.8 && lat <= 25.4 && lng >= 119.9 && lng <= 122.1)) {
    let city = '台灣地區';
    if (fullTxt.includes('台北') || fullTxt.includes('taipei')) city = '台北 Taipei';
    else if (fullTxt.includes('新北') || fullTxt.includes('new taipei')) city = '新北 New Taipei';
    else if (fullTxt.includes('台中') || fullTxt.includes('taichung')) city = '台中 Taichung';
    else if (fullTxt.includes('高雄') || fullTxt.includes('kaohsiung')) city = '高雄 Kaohsiung';
    else if (fullTxt.includes('宜蘭') || fullTxt.includes('頭城') || fullTxt.includes('yilan')) city = '宜蘭/頭城 Yilan';
    return { code: 'TW', country: '台灣 Taiwan', flag: '🇹🇼', city };
  }

  // 4. 🇺🇸 美國 (USA)
  if (fullTxt.includes('usa') || fullTxt.includes('united states') || fullTxt.includes('美國') || (lat >= 24.5 && lat <= 49.4 && lng >= -125.0 && lng <= -66.9) || (lat >= 18.9 && lat <= 22.3 && lng >= -160.3 && lng <= -154.8)) {
    let city = '美國 USA';
    if (fullTxt.includes('hawaii') || fullTxt.includes('oahu') || fullTxt.includes('pipeline') || (lat >= 18.9 && lat <= 22.3 && lng >= -160.3 && lng <= -154.8)) city = '夏威夷 Hawaii';
    else if (fullTxt.includes('california') || fullTxt.includes('los angeles') || fullTxt.includes('berrics') || fullTxt.includes('san diego') || (lat >= 32.5 && lat <= 42.0 && lng >= -124.4 && lng <= -114.1)) city = '加州 California (LA)';
    else if (fullTxt.includes('florida') || fullTxt.includes('miami')) city = '佛羅里達 Florida';
    else if (fullTxt.includes('new york') || fullTxt.includes('nyc')) city = '紐約 New York';
    return { code: 'US', country: '美國 USA', flag: '🇺🇸', city };
  }

  // 5. 🇦🇺 澳洲 (Australia)
  if (fullTxt.includes('australia') || fullTxt.includes('澳洲') || (lat >= -44.0 && lat <= -10.0 && lng >= 112.0 && lng <= 154.0)) {
    let city = '澳洲 Australia';
    if (fullTxt.includes('sydney') || fullTxt.includes('bondi') || (lat >= -34.2 && lat <= -33.5 && lng >= 150.5 && lng <= 151.4)) city = '雪梨 Sydney (Bondi)';
    else if (fullTxt.includes('brisbane') || fullTxt.includes('gold coast') || (lat >= -28.3 && lat <= -27.0 && lng >= 152.5 && lng <= 153.6)) city = '黃金海岸/布里斯本 Brisbane';
    else if (fullTxt.includes('melbourne')) city = '墨爾本 Melbourne';
    return { code: 'AU', country: '澳洲 Australia', flag: '🇦🇺', city };
  }

  // 6. 🇫🇷 法國 / 法屬玻里尼西亞 (France)
  if (fullTxt.includes('france') || fullTxt.includes('法國') || fullTxt.includes('tahiti') || fullTxt.includes('teahupoo') || (lat >= 41.3 && lat <= 51.1 && lng >= -5.2 && lng <= 9.6) || (lat >= -18.0 && lat <= -17.0 && lng >= -150.0 && lng <= -149.0)) {
    let city = '法國 France';
    if (fullTxt.includes('teahupoo') || fullTxt.includes('tahiti') || (lat >= -18.0 && lat <= -17.0 && lng >= -150.0 && lng <= -149.0)) city = '大溪地 Teahupoo';
    else if (fullTxt.includes('marseille') || fullTxt.includes('prado')) city = '馬賽 Marseille';
    else if (fullTxt.includes('paris')) city = '巴黎 Paris';
    return { code: 'FR', country: '法國 France', flag: '🇫🇷', city };
  }

  // 7. 🇨🇭 瑞士 / 🇦🇹 奧地利 (Alps Region)
  if (fullTxt.includes('switzerland') || fullTxt.includes('瑞士') || fullTxt.includes('zurich') || fullTxt.includes('austria') || fullTxt.includes('奧地利') || fullTxt.includes('innsbruck')) {
    let city = '瑞士/阿爾卑斯';
    if (fullTxt.includes('zurich')) city = '蘇黎世 Zurich';
    else if (fullTxt.includes('innsbruck')) city = '因斯布魯克 Innsbruck';
    return { code: 'CH', country: '瑞士/阿爾卑斯', flag: '🇨🇭', city };
  }

  // 8. 🇹🇭 泰國 (Thailand)
  if (fullTxt.includes('thailand') || fullTxt.includes('泰國') || (lat >= 5.6 && lat <= 20.5 && lng >= 97.3 && lng <= 105.7)) {
    let city = '泰國 Thailand';
    if (fullTxt.includes('bangkok') || fullTxt.includes('曼谷')) city = '曼谷 Bangkok';
    else if (fullTxt.includes('phuket') || fullTxt.includes('普吉')) city = '普吉島 Phuket';
    return { code: 'TH', country: '泰國 Thailand', flag: '🇹🇭', city };
  }

  // 預設全球
  return { code: 'ALL', country: rawCountry || 'Global', flag: '🌍', city: rawCity || '全球據點' };
}

let spots: SpotItem[] = [];
try {
  const jsonPath = path.resolve(process.cwd(), 'public/data/global_spots.json');
  if (fs.existsSync(jsonPath)) {
    const rawSpots = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    spots = rawSpots.map((s: any) => {
      const cat = s.category || 'SKATE';
      let badgeClass = 'text-xorange border-xorange/40 bg-xorange/10';
      let gearKeyword = 'skateboard helmet pads';
      if (cat === 'CLIMB') {
        badgeClass = 'text-emerald-400 border-emerald-500/40 bg-emerald-500/10';
        gearKeyword = 'climbing shoes chalk bag';
      } else if (cat === 'SURF') {
        badgeClass = 'text-cyan-400 border-cyan-500/40 bg-cyan-500/10';
        gearKeyword = 'surfboard leash wetsuit';
      } else if (cat === 'BMX') {
        badgeClass = 'text-purple-400 border-purple-500/40 bg-purple-500/10';
        gearKeyword = 'bmx helmet gloves guards';
      } else if (cat === 'SNOW') {
        badgeClass = 'text-sky-400 border-sky-500/40 bg-sky-500/10';
        gearKeyword = 'snowboard goggles gloves';
      }

      const spotLat = s.latitude ?? s.lat;
      const spotLng = s.longitude ?? s.lng;
      
      const navUrl = (spotLat && spotLng)
        ? ('https://www.google.com/maps/dir/?api=1&destination=' + spotLat + ',' + spotLng)
        : ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((s.name || '') + ' ' + (s.city || '')));

      const hotelUrl = (spotLat && spotLng)
        ? ('https://www.google.com/maps/search/hotels/@' + spotLat + ',' + spotLng + ',15z')
        : ('https://www.google.com/maps/search/' + encodeURIComponent('hotels near ' + (s.name || s.city || '')));

      // 🌍 執行全國家與城市精準反查
      const geo = resolveLocation(spotLat, spotLng, s.country || '', s.city || '', s.name || '');
      const regionTag = geo.flag + ' ' + geo.country + ' · ' + geo.city;

      let environment = '🏞️ 室外場 Outdoor';
      const nameAndFeatures = ((s.name || '') + ' ' + (s.features ? s.features.join(' ') : '') + ' ' + (s.surface_type || '')).toLowerCase();
      if (nameAndFeatures.includes('indoor') || nameAndFeatures.includes('室內') || nameAndFeatures.includes('gym') || nameAndFeatures.includes('館') || cat === 'CLIMB') {
        environment = '🏠 室內館 Indoor';
      }

      const officialUrl = (s.website && s.website.startsWith('http'))
        ? s.website
        : ('https://www.google.com/search?q=' + encodeURIComponent((s.name || '') + ' ' + (geo.city || '') + ' official site'));

      const gearUrl = 'https://www.amazon.com/s?k=' + encodeURIComponent(gearKeyword) + '&tag=kait02bc-20';

      // 🌟 難度與建議暢玩時間中文轉換
      let difficultyCn = '🌟 全級別適用 · ⏱️ 1-2小時';
      const rawDiff = (s.difficulty || '').toLowerCase();
      if (rawDiff.includes('beginner') || rawDiff.includes('初')) {
        difficultyCn = '🔰 初階新手 · ⏱️ 1小時';
      } else if (rawDiff.includes('intermediate') || rawDiff.includes('中')) {
        difficultyCn = '⚡ 中階進階 · ⏱️ 2-3小時';
      } else if (rawDiff.includes('pro') || rawDiff.includes('advanced') || rawDiff.includes('高') || rawDiff.includes('專')) {
        difficultyCn = '🔥 專業級 · ⏱️ 3小時+';
      }

      // 🏷️ 入場與收費狀態中文轉換
      let feeCn = '🔓 公開開放';
      const rawFee = (s.fee_type || '').toUpperCase();
      if (rawFee === 'FREE' || (s.fee_details && s.fee_details.includes('免費'))) {
        feeCn = '🟢 免費入場 Free';
      } else if (rawFee === 'PAID' || rawFee === 'FEE') {
        feeCn = '🎫 需收費/購票';
      } else {
        feeCn = '🔓 開放場地';
      }

      const searchStr = ((s.name || '') + ' ' + geo.country + ' ' + geo.city + ' ' + regionTag + ' ' + environment).toLowerCase();

      return {
        ...s,
        latitude: spotLat,
        longitude: spotLng,
        badgeClass,
        officialUrl,
        navUrl,
        hotelUrl,
        gearUrl,
        countryCode: geo.code,
        regionTag,
        environment,
        difficultyCn,
        feeCn,
        searchStr
      };
    });
  }
} catch (e) {
  console.error('Error loading spots:', e);
}

const totalSpots = spots.length;
---

<Layout
  title="📍 全球極限運動場地雷達庫 (Global Action Spots Radar) | xGame Radar"
  description="即時按國家地區與運動分類探索全球滑板場、碗池、衝浪浪點、攀岩抱石館與 BMX 泵道。附精準導航與官方周邊資訊。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <!-- Header Banner -->
    <div class="rounded-3xl bg-gradient-to-r from-xcard via-xdark to-xcard border border-xborder p-6 sm:p-10 relative overflow-hidden">
      <div class="space-y-3 max-w-3xl relative z-10">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-xorange text-white text-xs font-black uppercase tracking-wider shadow-glow-orange">
            GLOBAL SPOTS RADAR
          </span>
          <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold font-mono">
            已收錄 {totalSpots}+ 個頂級場地
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight uppercase">
          全球極限運動 <span class="text-xorange">國家與場地庫</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-300 font-medium leading-relaxed">
          支援即時按國家（日本、香港、台灣、美國、澳洲、法國等）與細分城市搜尋滑板場、巨型碗池、衝浪浪點、攀岩抱石館與 BMX 泵道。
        </p>
      </div>
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-xorange/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- 1️⃣ 國家 / 地區快速切換標籤 -->
    <div class="space-y-3 p-4 rounded-2xl bg-xcard/60 border border-xborder">
      <div class="text-xs font-bold font-mono text-gray-400 flex items-center gap-1.5">
        <span>🌍</span>
        <span>熱門國家 / 地區快速篩選：</span>
      </div>
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
        <button data-country="ALL" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-black uppercase bg-xorange text-white shadow-glow-orange shrink-0 transition">
          🔥 全部國家 (ALL)
        </button>
        <button data-country="JP" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇯🇵 日本 (Japan)
        </button>
        <button data-country="HK" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇭🇰 香港 (Hong Kong)
        </button>
        <button data-country="TW" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇹🇼 台灣 (Taiwan)
        </button>
        <button data-country="US" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇺🇸 美國 (USA)
        </button>
        <button data-country="AU" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇦🇺 澳洲 (Australia)
        </button>
        <button data-country="FR" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇫🇷 法國 (France)
        </button>
        <button data-country="CH" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇨🇭 瑞士/阿爾卑斯
        </button>
        <button data-country="TH" class="country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition">
          🇹🇭 泰國 (Thailand)
        </button>
      </div>
    </div>

    <!-- 2️⃣ 運動分類篩選與即時國家搜尋框 -->
    <div class="space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 p-4 rounded-2xl bg-xcard border border-xborder">
        <!-- 運動分類 -->
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0 scrollbar-none">
          <button data-cat="ALL" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-white/10 text-white hover:bg-white/20 transition">
            全部運動
          </button>
          <button data-cat="SKATE" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🛹 滑板
          </button>
          <button data-cat="CLIMB" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🧗 攀岩
          </button>
          <button data-cat="SURF" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🏄 衝浪
          </button>
          <button data-cat="BMX" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🚲 BMX
          </button>
        </div>

        <!-- 關鍵字搜尋框 (支援國家/細分城市/中英文) -->
        <div class="relative min-w-[320px]">
          <input
            type="text"
            id="spot-search-input"
            placeholder="🔍 搜尋國家、城市 (例: 東京、柴灣、台北、加州、夏威夷)..."
            class="w-full px-4 py-2.5 rounded-xl bg-xdark border border-xborder text-white text-xs focus:outline-none focus:border-xorange font-mono"
          />
        </div>
      </div>

      <div class="flex items-center justify-between text-xs font-mono text-gray-400 px-2">
        <span id="filtered-count-display" class="text-cyan-400 font-bold">
          ⚡ 顯示中：{totalSpots} 個場地
        </span>
        <span>提示：支援輸入具體城市或地區（例如：東京、大阪、柴灣、夏威夷）瞬時篩選</span>
      </div>
    </div>

    <!-- 3️⃣ 場地卡片網格 -->
    <div id="spots-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {spots.map((spot) => (
        <article
          class="spot-card rounded-2xl bg-xcard border border-xborder hover:border-xorange/60 transition-all duration-300 overflow-hidden flex flex-col justify-between group hover:-translate-y-1 shadow-lg p-5 space-y-4"
          data-category={spot.category}
          data-country={spot.countryCode}
          data-search={spot.searchStr}
        >
          <div class="space-y-3">
            <!-- 頂部標籤：類別 + 環境 (室內/室外) + 難度 + 收費 -->
            <div class="flex items-center justify-between flex-wrap gap-1.5">
              <div class="flex items-center gap-1.5">
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase border ${spot.badgeClass}`}>
                  {spot.category}
                </span>
                <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 text-[10px] font-bold font-mono border border-blue-500/30">
                  {spot.environment}
                </span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-full bg-black/50 text-[10px] font-bold text-cyan-300 font-mono border border-white/10">
                  {spot.difficultyCn}
                </span>
                <span class="px-2 py-0.5 rounded bg-black/50 text-[10px] font-mono text-emerald-400 border border-emerald-500/20">
                  {spot.feeCn}
                </span>
              </div>
            </div>

            <!-- 場地名稱與【國家＋細分城市標籤】 -->
            <div>
              <h3 class="font-black text-base text-white group-hover:text-xorange transition-colors leading-snug">
                {spot.name}
              </h3>
              <!-- 國家＋細分地區高亮徽章 -->
              <div class="inline-flex items-center gap-1.5 mt-2 px-3 py-1 rounded-lg bg-xdark border border-white/10 text-xs font-mono text-yellow-400 font-bold shadow-inner">
                <span>📍</span>
                <span class="truncate">{spot.regionTag}</span>
              </div>
            </div>

            <!-- 特色設施 / 規格 -->
            {spot.features && spot.features.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-1">
                {spot.features.slice(0, 3).map((f) => (
                  <span class="px-2 py-0.5 rounded-md bg-white/5 text-[10px] text-gray-300 font-mono border border-white/5">
                    {f}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- 功能動作按鈕 (100% 成功導航 + 地圖酒店 + 裝備推薦 + 官方資訊) -->
          <div class="grid grid-cols-2 gap-2 pt-3 border-t border-xborder/60 text-xs">
            <a
              href={spot.navUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-xdark hover:bg-xcard border border-xborder text-white font-bold transition text-center shadow-sm"
            >
              🧭 路線導航
            </a>
            <a
              href={spot.hotelUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-blue-600/20 hover:bg-blue-600/40 border border-blue-500/30 text-blue-300 font-bold transition text-center"
            >
              🏨 周邊酒店
            </a>
            <a
              href={spot.gearUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-xorange hover:bg-orange-600 text-white font-bold transition text-center shadow-glow-orange"
            >
              🛒 專屬裝備
            </a>
            <a
              href={spot.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/40 border border-emerald-500/30 text-emerald-300 font-bold transition text-center"
            >
              🌐 官方資訊
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let currentCategory = 'ALL';
      let currentCountry = 'ALL';
      let searchQuery = '';

      const searchInput = document.getElementById('spot-search-input');
      const catButtons = document.querySelectorAll('.cat-filter-btn');
      const countryButtons = document.querySelectorAll('.country-filter-btn');
      const cards = document.querySelectorAll('.spot-card');
      const countDisplay = document.getElementById('filtered-count-display');

      function filterSpots() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const cardCountry = card.getAttribute('data-country');
          const searchData = card.getAttribute('data-search') || '';

          const matchesCat = currentCategory === 'ALL' || cardCat === currentCategory;
          const matchesCountry = currentCountry === 'ALL' || cardCountry === currentCountry;
          const matchesSearch = !searchQuery || searchData.includes(searchQuery.toLowerCase());

          if (matchesCat && matchesCountry && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.innerText = `⚡ 顯示中：${visibleCount} 個場地`;
        }
      }

      // 即時關鍵字搜尋 (國家/細分城市/場地名稱)
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim();
          filterSpots();
        });
      }

      // 國家切換
      countryButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCountry = btn.getAttribute('data-country');

          countryButtons.forEach((b) => {
            b.className = 'country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition';
          });
          btn.className = 'country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-black uppercase bg-xorange text-white shadow-glow-orange shrink-0 transition';

          filterSpots();
        });
      });

      // 運動分類切換
      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-cat');

          catButtons.forEach((b) => {
            b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition';
          });
          btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-white/20 text-white shadow-glow-orange transition';

          filterSpots();
        });
      });
    });
  </script>
</Layout>
