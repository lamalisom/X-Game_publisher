---
import Layout from '../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

interface SpotItem {
  name: string;
  category: string;
  difficulty?: string;
  fee_type?: string;
  city?: string;
  country?: string;
  latitude?: number;
  longitude?: number;
  lat?: number;
  lng?: number;
  features?: string[];
  website?: string;
  affiliate_gear_url?: string;
  affiliate_hotel_url?: string;
  badgeClass?: string;
  officialUrl?: string;
  hasDirectSite?: boolean;
  navUrl?: string;
  searchStr?: string;
  displayLocation?: string;
}

let spots: SpotItem[] = [];
try {
  const jsonPath = path.resolve(process.cwd(), 'public/data/global_spots.json');
  if (fs.existsSync(jsonPath)) {
    const rawSpots = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    spots = rawSpots.map((s: any) => {
      const cat = s.category || 'SKATE';
      let badgeClass = 'text-xorange border-xorange/40';
      if (cat === 'CLIMB') badgeClass = 'text-emerald-400 border-emerald-500/40';
      if (cat === 'SURF') badgeClass = 'text-cyan-400 border-cyan-500/40';
      if (cat === 'BMX') badgeClass = 'text-purple-400 border-purple-500/40';

      const latitude = s.latitude ?? s.lat;
      const longitude = s.longitude ?? s.lng;
      const navUrl = (latitude && longitude)
        ? ('https://www.google.com/maps/dir/?api=1&destination=' + latitude + ',' + longitude)
        : ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((s.name || '') + ' ' + (s.city || '')));

      const hasDirectSite = Boolean(s.website && s.website.startsWith('http'));
      const officialUrl = hasDirectSite
        ? s.website
        : ('https://www.google.com/search?q=' + encodeURIComponent((s.name || '') + ' ' + (s.city || '') + ' official site'));

      const searchStr = ((s.name || '') + ' ' + (s.city || '') + ' ' + (s.country || '')).toLowerCase();
      const displayLocation = s.city ? (s.city + (s.country ? ', ' + s.country : '')) : (s.country || 'Global');

      return {
        ...s,
        badgeClass,
        officialUrl,
        hasDirectSite,
        navUrl,
        searchStr,
        displayLocation
      };
    });
  }
} catch (e) {
  console.error('Error loading spots:', e);
}

const totalSpots = spots.length;
---

<Layout
  title="📍 全球極限運動場地雷達庫 (Global Action Spots Radar) | xGame Radar"
  description="即時探索全球滑板場、碗池、衝浪浪點、攀岩抱石館與 BMX 泵道。附官方網站、Google Maps 導航與周邊預約。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10">
    
    <div class="rounded-3xl bg-gradient-to-r from-xcard via-xdark to-xcard border border-xborder p-6 sm:p-10 relative overflow-hidden">
      <div class="space-y-3 max-w-3xl relative z-10">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-xorange text-white text-xs font-black uppercase tracking-wider shadow-glow-orange">
            GLOBAL SPOTS RADAR
          </span>
          <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold font-mono">
            已收錄 {totalSpots}+ 個頂級場地
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight uppercase">
          全球極限運動 <span class="text-xorange">場地探索庫</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-300 font-medium leading-relaxed">
          收錄全球街式滑板場（Skatepark）、巨型碗池（Bowl）、衝浪浪點（Surf Break）、抱石攀岩館（Climbing Gym）與 BMX 泵道。
        </p>
      </div>
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-xorange/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <div class="space-y-4">
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 p-4 rounded-2xl bg-xcard border border-xborder">
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 md:pb-0">
          <button data-cat="ALL" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-xorange text-white shadow-glow-orange transition">
            🔥 全部 ({totalSpots})
          </button>
          <button data-cat="SKATE" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🛹 滑板 SKATE
          </button>
          <button data-cat="CLIMB" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🧗 攀岩 CLIMB
          </button>
          <button data-cat="SURF" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🏄 衝浪 SURF
          </button>
          <button data-cat="BMX" class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition">
            🚲 小輪 BMX
          </button>
        </div>

        <div class="relative min-w-[260px]">
          <input
            type="text"
            id="spot-search-input"
            placeholder="🔍 搜尋城市、場地名稱 (例如: 東京、柴灣)..."
            class="w-full px-4 py-2.5 rounded-xl bg-xdark border border-xborder text-white text-xs focus:outline-none focus:border-xorange font-mono"
          />
        </div>
      </div>

      <div class="flex items-center justify-between text-xs font-mono text-gray-400 px-2">
        <span id="filtered-count-display" class="text-cyan-400 font-bold">
          ⚡ 顯示中：{totalSpots} 個場地
        </span>
        <span>提示：點擊「🧭 路線導航」開啟 Google Maps 路線；「🌐 官方網站」直接開啟場地官方網址</span>
      </div>
    </div>

    <div id="spots-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {spots.map((spot) => (
        <article
          class="spot-card rounded-2xl bg-xcard border border-xborder hover:border-xorange/60 transition-all duration-300 overflow-hidden flex flex-col justify-between group hover:-translate-y-1 shadow-lg p-5 space-y-4"
          data-category={spot.category}
          data-search={spot.searchStr}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class={}>
                {spot.category || 'SKATE'}
              </span>
              <span class="px-2 py-0.5 rounded-full bg-black/50 text-[10px] font-bold text-cyan-300 font-mono border border-white/10">
                {spot.difficulty || 'All Levels'}
              </span>
              <span class="px-2 py-0.5 rounded bg-black/50 text-[10px] font-mono text-emerald-400">
                {spot.fee_type || 'OPEN'}
              </span>
            </div>

            <div>
              <h3 class="font-black text-base text-white group-hover:text-xorange transition-colors leading-snug">
                {spot.name}
              </h3>
              <p class="text-xs text-gray-400 font-mono flex items-center gap-1 mt-1">
                <span>📍</span>
                <span class="truncate">{spot.displayLocation}</span>
              </p>
            </div>

            {spot.features && spot.features.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-1">
                {spot.features.slice(0, 3).map((f) => (
                  <span class="px-1.5 py-0.5 rounded bg-white/5 text-[10px] text-gray-300 font-mono border border-white/5">
                    {f}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="grid grid-cols-2 gap-2 pt-3 border-t border-xborder/60 text-xs">
            <a
              href={spot.navUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-xdark hover:bg-xcard border border-xborder text-white font-bold transition text-center"
            >
              🧭 路線導航
            </a>
            <a
              href={spot.affiliate_gear_url || 'https://www.amazon.com/s?k=extreme+sports+gear&tag=kait02bc-20'}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-xorange hover:bg-orange-600 text-white font-bold transition text-center shadow-glow-orange"
            >
              🛒 推薦裝備
            </a>
            <a
              href={spot.affiliate_hotel_url || 'https://www.agoda.com'}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-blue-600/30 hover:bg-blue-600/50 border border-blue-500/40 text-blue-300 font-bold transition text-center"
            >
              🏨 附近住宿
            </a>
            <a
              href={spot.officialUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1 py-2 px-2.5 rounded-xl bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-500/40 text-emerald-300 font-bold transition text-center"
            >
              {spot.hasDirectSite ? '🌐 官方網站' : '🔍 官方資訊'}
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let currentCategory = 'ALL';
      let searchQuery = '';

      const searchInput = document.getElementById('spot-search-input');
      const catButtons = document.querySelectorAll('.cat-filter-btn');
      const cards = document.querySelectorAll('.spot-card');
      const countDisplay = document.getElementById('filtered-count-display');

      function filterSpots() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const searchData = card.getAttribute('data-search') || '';

          const matchesCat = currentCategory === 'ALL' || cardCat === currentCategory;

          if (matchesCat && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.innerText = ;
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim();
          filterSpots();
        });
      }

      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-cat');

          catButtons.forEach((b) => {
            b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition';
          });
          btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-xorange text-white shadow-glow-orange transition';

          filterSpots();
        });
      });
    });
  </script>
</Layout>
