---
import Layout from '../../../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

interface SpotItem {
  name: string;
  category: string;
  difficulty?: string;
  difficultyCn?: string;
  feeCn?: string;
  city?: string;
  country?: string;
  latitude?: number;
  longitude?: number;
  lat?: number;
  lng?: number;
  features?: string[];
  website?: string;
  surface_type?: string;
  environment?: string;
  badgeClass?: string;
  officialUrl?: string;
  navUrl?: string;
  hotelUrl?: string;
  gearUrl?: string;
  searchStr?: string;
  countryCode?: string;
  regionTag?: string;
}

function resolveLocationEN(lat: number, lng: number, countryCode: string, cityName: string, spotName: string) {
  const name = (spotName || '').toLowerCase();
  const c = (countryCode || '').toUpperCase();

  // 🇹🇭 泰國 (Thailand)
  if (c === 'TH' || (lat >= 5.5 && lat <= 20.5 && lng >= 97.0 && lng <= 106.0)) {
    if ((lat >= 13.5 && lat <= 14.1 && lng >= 100.2 && lng <= 100.9) || name.includes('bangkok') || name.includes('曼谷')) return { flag: '🇹🇭', country: 'Thailand', city: '曼谷 Bangkok' };
    if ((lat >= 7.7 && lat <= 8.3 && lng >= 98.2 && lng <= 98.5) || name.includes('phuket') || name.includes('普吉')) return { flag: '🇹🇭', country: 'Thailand', city: '普吉島 Phuket' };
    if ((lat >= 18.5 && lat <= 19.1 && lng >= 98.7 && lng <= 99.3) || name.includes('chiang mai') || name.includes('清邁')) return { flag: '🇹🇭', country: 'Thailand', city: '清邁 Chiang Mai' };
    if ((lat >= 12.6 && lat <= 13.1 && lng >= 100.8 && lng <= 101.4) || name.includes('pattaya') || name.includes('芭達雅')) return { flag: '🇹🇭', country: 'Thailand', city: '芭達雅 Pattaya' };
    if ((lat >= 9.3 && lat <= 9.9 && lng >= 99.8 && lng <= 100.25) || name.includes('samui') || name.includes('蘇梅')) return { flag: '🇹🇭', country: 'Thailand', city: '蘇梅島 Koh Samui' };
    if ((lat >= 7.9 && lat <= 8.25 && lng >= 98.7 && lng <= 99.1) || name.includes('krabi') || name.includes('甲米')) return { flag: '🇹🇭', country: 'Thailand', city: '甲米 Krabi' };
    return { flag: '🇹🇭', country: 'Thailand', city: '泰國 Thailand' };
  }

  // 🇮🇩 印尼 (Indonesia)
  if (c === 'ID' || (lat >= -11.0 && lat <= 6.0 && lng >= 95.0 && lng <= 141.0)) {
    if (lat >= -8.95 && lat <= -8.00 && lng >= 114.40 && lng <= 115.80) {
      if ((lat >= -8.75 && lat <= -8.55 && lng >= 115.10 && lng <= 115.25) || name.includes('canggu') || name.includes('kuta') || name.includes('seminyak') || name.includes('蒼古') || name.includes('庫塔')) {
        return { flag: '🇮🇩', country: 'Indonesia', city: '峇里島 · 蒼古/庫塔 Canggu' };
      }
      if ((lat >= -8.89 && lat <= -8.76 && lng >= 115.05 && lng <= 115.20) || name.includes('uluwatu') || name.includes('bukit') || name.includes('烏魯瓦圖')) {
        return { flag: '🇮🇩', country: 'Indonesia', city: '峇里島 · 烏魯瓦圖 Uluwatu' };
      }
      return { flag: '🇮🇩', country: 'Indonesia', city: '峇里島 Bali' };
    }
    if ((lat >= -9.00 && lat <= -8.10 && lng >= 115.80 && lng <= 116.80) || name.includes('lombok') || name.includes('龍目')) return { flag: '🇮🇩', country: 'Indonesia', city: '龍目島 Lombok' };
    if (name.includes('mentawai') || name.includes('明打威') || (lat >= -4.0 && lat <= 0.0 && lng >= 98.0 && lng <= 101.5)) return { flag: '🇮🇩', country: 'Indonesia', city: '明打威 Mentawai' };
    if (lat >= -8.9 && lat <= -5.8 && lng >= 105.0 && lng <= 114.5) return { flag: '🇮🇩', country: 'Indonesia', city: '爪哇 Java' };
    return { flag: '🇮🇩', country: 'Indonesia', city: '印尼 Indonesia' };
  }

  // 🇸🇪 瑞典 (Sweden)
  if (c === 'SE' || (lat >= 55.0 && lat <= 69.5 && lng >= 11.0 && lng <= 24.5)) {
    if ((lat >= 59.10 && lat <= 59.60 && lng >= 17.70 && lng <= 18.40) || name.includes('stockholm') || name.includes('斯德哥爾摩')) return { flag: '🇸🇪', country: 'Sweden', city: '斯德哥爾摩 Stockholm' };
    if ((lat >= 55.40 && lat <= 55.80 && lng >= 12.80 && lng <= 13.30) || name.includes('malmö') || name.includes('馬爾默')) return { flag: '🇸🇪', country: 'Sweden', city: '馬爾默 Malmö' };
    if ((lat >= 57.50 && lat <= 57.90 && lng >= 11.70 && lng <= 12.30) || name.includes('gothenburg') || name.includes('哥德堡')) return { flag: '🇸🇪', country: 'Sweden', city: '哥德堡 Gothenburg' };
    return { flag: '🇸🇪', country: 'Sweden', city: '瑞典 Sweden' };
  }

  // 🇯🇵 日本
  if (c === 'JP' || (lat >= 24.0 && lat <= 46.0 && lng >= 122.0 && lng <= 154.0)) {
    if (name.includes('tokyo') || name.includes('東京') || (lat >= 35.5 && lat <= 35.9 && lng >= 139.5 && lng <= 140.0)) return { flag: '🇯🇵', country: 'Japan', city: '東京 Tokyo' };
    if (name.includes('osaka') || name.includes('大阪') || (lat >= 34.5 && lat <= 34.9 && lng >= 135.3 && lng <= 135.7)) return { flag: '🇯🇵', country: 'Japan', city: '大阪 Osaka' };
    if (name.includes('kanagawa') || name.includes('神奈川') || name.includes('yokohama') || name.includes('shonan') || name.includes('湘南')) return { flag: '🇯🇵', country: 'Japan', city: '神奈川/湘南 Shonan' };
    if (name.includes('okinawa') || name.includes('沖繩')) return { flag: '🇯🇵', country: 'Japan', city: '沖繩 Okinawa' };
    if (name.includes('hokkaido') || name.includes('北海道') || name.includes('niseko')) return { flag: '🇯🇵', country: 'Japan', city: '北海道 Hokkaido' };
    if (name.includes('chiba') || name.includes('千葉')) return { flag: '🇯🇵', country: 'Japan', city: '千葉 Chiba' };
    if (name.includes('shizuoka') || name.includes('靜岡')) return { flag: '🇯🇵', country: 'Japan', city: '靜岡 Shizuoka' };
    return { flag: '🇯🇵', country: 'Japan', city: cityName || 'Japan' };
  }

  // 🇭🇰 香港
  if (c === 'HK' || (lat >= 22.15 && lat <= 22.58 && lng >= 113.80 && lng <= 114.45)) {
    return { flag: '🇭🇰', country: 'Hong Kong', city: cityName || '香港 Hong Kong' };
  }

  // 🇹🇼 台灣
  if (c === 'TW' || (lat >= 21.8 && lat <= 25.4 && lng >= 119.9 && lng <= 122.1)) {
    if (name.includes('taipei') || name.includes('台北') || (lat >= 24.95 && lat <= 25.22 && lng >= 121.40 && lng <= 121.68)) return { flag: '🇹🇼', country: 'Taiwan', city: '台北 Taipei' };
    if (name.includes('yilan') || name.includes('宜蘭') || name.includes('waiao') || name.includes('外澳')) return { flag: '🇹🇼', country: 'Taiwan', city: '宜蘭 Yilan' };
    if (name.includes('taitung') || name.includes('台東') || name.includes('donghe') || name.includes('東河')) return { flag: '🇹🇼', country: 'Taiwan', city: '台東 Taitung' };
    if (name.includes('kenting') || name.includes('墾丁') || name.includes('jialeshui') || name.includes('佳樂水')) return { flag: '🇹🇼', country: 'Taiwan', city: '墾丁 Kenting' };
    if (name.includes('taichung') || name.includes('台中')) return { flag: '🇹🇼', country: 'Taiwan', city: '台中 Taichung' };
    if (name.includes('kaohsiung') || name.includes('高雄')) return { flag: '🇹🇼', country: 'Taiwan', city: '高雄 Kaohsiung' };
    return { flag: '🇹🇼', country: 'Taiwan', city: cityName || '台灣 Taiwan' };
  }

  // 🇺🇸 美國
  if (c === 'US' || (lat >= 18.0 && lat <= 72.0 && lng >= -170.0 && lng <= -65.0)) {
    if (name.includes('california') || name.includes('加州') || name.includes('la') || name.includes('los angeles') || (lat >= 32.5 && lat <= 42.0 && lng >= -124.5 && lng <= -114.0)) return { flag: '🇺🇸', country: 'USA', city: '加州 California' };
    if (name.includes('hawaii') || name.includes('夏威夷') || name.includes('oahu') || name.includes('north shore') || (lat >= 18.8 && lat <= 22.3 && lng >= -160.5 && lng <= -154.8)) return { flag: '🇺🇸', country: 'USA', city: '夏威夷 Hawaii' };
    if (name.includes('new york') || name.includes('紐約') || (lat >= 40.5 && lat <= 45.0 && lng >= -79.8 && lng <= -71.8)) return { flag: '🇺🇸', country: 'USA', city: '紐約 New York' };
    if (name.includes('florida') || name.includes('佛羅里達')) return { flag: '🇺🇸', country: 'USA', city: '佛羅里達 Florida' };
    return { flag: '🇺🇸', country: 'USA', city: cityName || '美國 USA' };
  }

  // 🇦🇺 澳洲
  if (c === 'AU' || (lat >= -44.0 && lat <= -10.0 && lng >= 112.0 && lng <= 154.0)) {
    if (name.includes('gold coast') || name.includes('黃金海岸')) return { flag: '🇦🇺', country: 'Australia', city: '黃金海岸 Gold Coast' };
    if (name.includes('sydney') || name.includes('雪梨') || name.includes('bondi')) return { flag: '🇦🇺', country: 'Australia', city: '雪梨 Sydney' };
    if (name.includes('melbourne') || name.includes('墨爾本') || name.includes('torquay')) return { flag: '🇦🇺', country: 'Australia', city: '墨爾本 Melbourne' };
    return { flag: '🇦🇺', country: 'Australia', city: cityName || '澳洲 Australia' };
  }

  // 🇫🇷 法國
  if (c === 'FR' || (lat >= 41.0 && lat <= 51.5 && lng >= -5.5 && lng <= 10.0)) {
    if (name.includes('paris') || name.includes('巴黎')) return { flag: '🇫🇷', country: 'France', city: '巴黎 Paris' };
    if (name.includes('marseille') || name.includes('馬賽')) return { flag: '🇫🇷', country: 'France', city: '馬賽 Marseille' };
    if (name.includes('hossegor') || name.includes('biarritz')) return { flag: '🇫🇷', country: 'France', city: '西南海岸 Hossegor' };
    return { flag: '🇫🇷', country: 'France', city: cityName || '法國 France' };
  }

  // 🇨🇭 瑞士
  if (c === 'CH' || (lat >= 45.8 && lat <= 47.9 && lng >= 5.9 && lng <= 10.5)) {
    if (name.includes('laax') || name.includes('zermatt') || name.includes('saas-fee')) return { flag: '🇨🇭', country: 'Switzerland', city: '阿爾卑斯 Alps' };
    return { flag: '🇨🇭', country: 'Switzerland', city: cityName || '瑞士 Switzerland' };
  }

  return { flag: '🌐', country: countryCode || 'Global', city: cityName || 'Spot' };
}

let spots: SpotItem[] = [];
try {
  const jsonPath = path.resolve(process.cwd(), 'public/data/global_spots.json');
  if (fs.existsSync(jsonPath)) {
    const rawSpots = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
    spots = rawSpots.map((s: any) => {
      const cat = s.category || 'SKATE';
      let badgeClass = 'text-xorange border-xorange/40 bg-xorange/10';
      let gearKeyword = 'skateboard helmet pads';
      if (cat === 'CLIMB') {
        badgeClass = 'text-emerald-400 border-emerald-500/40 bg-emerald-500/10';
        gearKeyword = 'climbing shoes chalk bag';
      } else if (cat === 'SURF') {
        badgeClass = 'text-cyan-400 border-cyan-500/40 bg-cyan-500/10';
        gearKeyword = 'surfboard leash wetsuit';
      } else if (cat === 'BMX') {
        badgeClass = 'text-purple-400 border-purple-500/40 bg-purple-500/10';
        gearKeyword = 'bmx helmet gloves guards';
      } else if (cat === 'SNOW') {
        badgeClass = 'text-sky-400 border-sky-500/40 bg-sky-500/10';
        gearKeyword = 'snowboard goggles gloves';
      }

      const spotLat = s.latitude ?? s.lat;
      const spotLng = s.longitude ?? s.lng;
      
      const navUrl = (spotLat && spotLng)
        ? ('https://www.google.com/maps/dir/?api=1&destination=' + spotLat + ',' + spotLng)
        : ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent((s.name || '') + ' ' + (s.city || '')));

      const hotelAffiliateCid = '1898765';
      const hotelUrl = (spotLat && spotLng)
        ? ('https://www.agoda.com/partners/partnersearch.aspx?cid=' + hotelAffiliateCid + '&latitude=' + spotLat + '&longitude=' + spotLng + '&text=' + encodeURIComponent((s.name || '')) + '&pcs=1')
        : ('https://www.agoda.com/search?text=' + encodeURIComponent((s.name || '')));

      const geo = resolveLocationEN(spotLat, spotLng, s.country || '', s.city || '', s.name || '');
      const regionTag = geo.flag + ' ' + geo.country + ' · ' + geo.city;

      let environment = '🏞️ 室外場';
      const nameAndFeatures = ((s.name || '') + ' ' + (s.features ? s.features.join(' ') : '') + ' ' + (s.surface_type || '')).toLowerCase();
      if (nameAndFeatures.includes('indoor') || nameAndFeatures.includes('室內') || nameAndFeatures.includes('gym') || nameAndFeatures.includes('館') || cat === 'CLIMB') {
        environment = '🏠 室內館';
      }

      // 中文難度
      let difficultyCn = '🌟 全級別適用 · ⏱️ 1-2小時';
      const rawDiff = (s.difficulty || '').toLowerCase();
      if (rawDiff.includes('beginner') || rawDiff.includes('初')) {
        difficultyCn = '🔰 初階新手 · ⏱️ 1小時';
      } else if (rawDiff.includes('intermediate') || rawDiff.includes('中')) {
        difficultyCn = '⚡ 中階進階 · ⏱️ 2-3小時';
      } else if (rawDiff.includes('pro') || rawDiff.includes('advanced') || rawDiff.includes('高') || rawDiff.includes('專')) {
        difficultyCn = '🔥 專業級 · ⏱️ 3小時+';
      }

      // 中文開放狀態
      let feeCn = '🔓 開放場地';
      const rawFee = (s.fee_type || '').toUpperCase();
      if (rawFee === 'FREE' || (s.fee_details && s.fee_details.includes('免費'))) {
        feeCn = '🟢 免費入場';
      } else if (rawFee === 'PAID' || rawFee === 'FEE') {
        feeCn = '🎫 需收費';
      }

      const officialUrl = (s.website && s.website.startsWith('http'))
        ? s.website
        : ('https://www.google.com/search?q=' + encodeURIComponent((s.name || '') + ' ' + (geo.city || '') + ' 官方網站'));

      const gearUrl = 'https://www.amazon.com/s?k=' + encodeURIComponent(gearKeyword) + '&tag=kait02bc-20';
      const searchStr = ((s.name || '') + ' ' + geo.country + ' ' + geo.city + ' ' + regionTag + ' ' + environment).toLowerCase();

      return {
        ...s,
        latitude: spotLat,
        longitude: spotLng,
        badgeClass,
        officialUrl,
        navUrl,
        hotelUrl,
        gearUrl,
        countryCode: geo.code,
        regionTag,
        environment,
        difficultyCn,
        feeCn,
        searchStr
      };
    });
  }
} catch (e) {
  console.error('Error loading spots:', e);
}

const totalSpots = spots.length;
---

<Layout
  title="📍 全球極限運動場地雷達庫 (Global Action Spots Radar) | xGame Radar"
  description="即時探索全球滑板場、碗池、衝浪浪點、攀岩抱石館與 BMX 泵道。附國家分區規格、路線導航與周邊推薦。"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-8">
    
    <!-- 頂部切換語言按鈕 -->
    <div class="flex justify-end">
      <a href="/spots/map/en" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-xcard border border-xborder text-xs font-mono text-gray-300 hover:text-white hover:border-cyan-500 transition">
        <span>🌐</span>
        <span class="font-bold">Switch to English (英文版) →</span>
      </a>
    </div>

    <!-- Header Banner -->
    <div class="rounded-3xl bg-gradient-to-r from-xcard via-xdark to-xcard border border-xborder p-6 sm:p-10 relative overflow-hidden">
      <div class="space-y-3 max-w-3xl relative z-10">
        <div class="flex items-center gap-2">
          <span class="px-3 py-1 rounded-full bg-xorange text-white text-xs font-black uppercase tracking-wider shadow-glow-orange">
            場地雷達庫
          </span>
          <span class="px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 text-xs font-bold font-mono">
            已收錄 {totalSpots}+ 個頂級場地
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white leading-tight tracking-tight">
          全球極限運動 <span class="text-xorange">場地探索庫</span>
        </h1>
        <p class="text-sm sm:text-base text-gray-300 font-medium leading-relaxed">
          收錄全球街式滑板場、巨型碗池、世界級浪點、抱石攀岩館與 BMX 泵道，支援按國家與城市即時搜尋。
        </p>
      </div>
      <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-xorange/10 rounded-full blur-3xl pointer-events-none"></div>
    </div>

    <!-- 1️⃣ 國家快速切換標籤 (純中文) -->
    <div class="space-y-3 p-4 rounded-2xl bg-xcard/60 border border-xborder">
      <div class="text-xs font-bold font-mono text-gray-400 flex items-center gap-1.5">
        <span>🌍</span>
        <span>熱門國家快速篩選：</span>
      </div>
      <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
      <button data-country="ALL" class="country-btn active px-3.5 py-1.5 rounded-full text-xs font-bold bg-xorange text-white shadow-lg shadow-xorange/20 transition">🔥 全部國家</button>
      <button data-country="JP" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇯🇵 日本</button>
      <button data-country="HK" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇭🇰 香港</button>
      <button data-country="TW" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇹🇼 台灣</button>
      <button data-country="TH" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇹🇭 泰國</button>
      <button data-country="ID" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇮🇩 印尼</button>
      <button data-country="US" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇺🇸 美國</button>
      <button data-country="AU" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇦🇺 澳洲</button>
      <button data-country="FR" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇫🇷 法國</button>
      <button data-country="SE" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇸🇪 瑞典</button>
      <button data-country="CH" class="country-btn px-3 py-1.5 rounded-full text-xs font-semibold bg-gray-900/80 text-gray-300 hover:text-white border border-xborder transition">🇨🇭 瑞士</button>
          data-search={spot.searchStr}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between flex-wrap gap-1.5">
              <div class="flex items-center gap-1.5">
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase border ${spot.badgeClass}`}>
                  {spot.category}
                </span>
                <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-300 text-[10px] font-bold font-mono border border-blue-500/30">
                  {spot.environment}
                </span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="px-2 py-0.5 rounded-full bg-black/50 text-[10px] font-bold text-cyan-300 font-mono border border-white/10">
                  {spot.difficultyCn}
                </span>
                <span class="px-2 py-0.5 rounded bg-black/50 text-[10px] font-mono text-emerald-400 border border-emerald-500/20">
                  {spot.feeCn}
                </span>
              </div>
            </div>

            <div>
              <h3 class="font-black text-base text-white group-hover:text-xorange transition-colors leading-snug">
                {spot.name}
              </h3>
              <div class="inline-flex items-center gap-1.5 mt-2 px-3 py-1 rounded-lg bg-xdark border border-white/10 text-xs font-mono text-yellow-400 font-bold shadow-inner">
                <span>📍</span>
                <span class="truncate">{spot.regionTag}</span>
              </div>
            </div>

            {spot.features && spot.features.length > 0 && (
              <div class="flex flex-wrap gap-1 pt-1">
                {spot.features.slice(0, 3).map((f) => (
                  <span class="px-2 py-0.5 rounded-md bg-white/5 text-[10px] text-gray-300 font-mono border border-white/5">
                    {f}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="grid grid-cols-2 gap-2 pt-3 border-t border-xborder/60 text-xs">
            <a href={spot.navUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-xdark hover:bg-xcard border border-xborder text-white font-bold transition text-center shadow-sm">
              🧭 路線導航
            </a>
            <a href={spot.hotelUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-blue-600/20 hover:bg-blue-600/40 border border-blue-500/30 text-blue-300 font-bold transition text-center">
              🏨 周邊酒店
            </a>
            <a href={spot.gearUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-xorange hover:bg-orange-600 text-white font-bold transition text-center shadow-glow-orange">
              🛒 專屬裝備
            </a>
            <a href={spot.officialUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-1 py-2 px-2 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/40 border border-emerald-500/30 text-emerald-300 font-bold transition text-center">
              🌐 官方資訊
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let currentCategory = 'ALL';
      let currentCountry = 'ALL';
      let searchQuery = '';

      const searchInput = document.getElementById('spot-search-input');
      const catButtons = document.querySelectorAll('.cat-filter-btn');
      const countryButtons = document.querySelectorAll('.country-filter-btn');
      const cards = document.querySelectorAll('.spot-card');
      const countDisplay = document.getElementById('filtered-count-display');

      function filterSpots() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          const cardCountry = card.getAttribute('data-country');
          const searchData = card.getAttribute('data-search') || '';

          const matchesCat = currentCategory === 'ALL' || cardCat === currentCategory;
          const matchesCountry = currentCountry === 'ALL' || cardCountry === currentCountry;
          const matchesSearch = !searchQuery || searchData.includes(searchQuery.toLowerCase());

          if (matchesCat && matchesCountry && matchesSearch) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countDisplay) {
          countDisplay.innerText = `⚡ 顯示中：${visibleCount} 個場地`;
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim();
          filterSpots();
        });
      }

      countryButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCountry = btn.getAttribute('data-country');
          countryButtons.forEach((b) => {
            b.className = 'country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold text-gray-300 hover:text-white hover:bg-xdark border border-white/10 shrink-0 transition';
          });
          btn.className = 'country-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-black uppercase bg-xorange text-white shadow-glow-orange shrink-0 transition';
          filterSpots();
        });
      });

      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-cat');
          catButtons.forEach((b) => {
            b.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xdark transition';
          });
          btn.className = 'cat-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider bg-white/20 text-white shadow-glow-orange transition';
          filterSpots();
        });
      });
    });
  </script>
</Layout>
