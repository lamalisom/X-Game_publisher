---
interface Props {
  initialLat?: number;
  initialLng?: number;
  initialZoom?: number;
  selectedCategory?: string;
}

const {
  initialLat = 35.6762,
  initialLng = 139.6503,
  initialZoom = 9,
  selectedCategory = 'ALL'
} = Astro.props;

const mapboxToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || '';
---

<div class="relative w-full h-[78vh] min-h-[550px] rounded-3xl overflow-hidden border border-xborder bg-xdark shadow-2xl">
  
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.css" rel="stylesheet" />
  <script is:inline src="https://api.mapbox.com/mapbox-gl-js/v3.4.0/mapbox-gl.js"></script>

  <!-- Top Floating Controls -->
  <div class="absolute top-4 left-4 right-4 z-20 flex flex-wrap items-center justify-between gap-3 pointer-events-none">
    <div class="flex items-center gap-1.5 p-1.5 rounded-2xl bg-xblack/85 backdrop-blur-md border border-xborder/80 shadow-xl pointer-events-auto overflow-x-auto max-w-full">
      <button data-cat="ALL" class="cat-btn px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-200 bg-xorange text-white shadow-glow-orange">
        🔥 全部 ALL
      </button>
      <button data-cat="SKATE" class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xcard transition-all">
        🛹 滑板 SKATE
      </button>
      <button data-cat="CLIMB" class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xcard transition-all">
        🧗 攀岩 CLIMB
      </button>
      <button data-cat="SURF" class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xcard transition-all">
        🏄 衝浪 SURF
      </button>
      <button data-cat="BMX" class="cat-btn px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xcard transition-all">
        🚲 小輪 BMX
      </button>
    </div>

    <div class="flex items-center gap-3 px-4 py-2 rounded-2xl bg-xblack/85 backdrop-blur-md border border-xborder/80 shadow-xl pointer-events-auto text-xs font-mono">
      <span class="flex items-center gap-1.5 text-cyan-400 font-bold">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span id="spots-count">探索中...</span>
      </span>
      <span class="text-gray-500">|</span>
      <span class="text-gray-400 text-[11px]">BBox 空間雷達</span>
    </div>
  </div>

  <div id="mapbox-container" class="w-full h-full"></div>

  <!-- Quick Presets -->
  <div class="absolute bottom-6 left-6 z-20 flex flex-wrap gap-2 pointer-events-auto">
    <div class="px-3 py-1.5 rounded-xl bg-xblack/90 backdrop-blur-md border border-xborder text-[11px] font-mono text-gray-300 flex items-center gap-2 shadow-lg">
      <span class="text-gray-400">快速切換：</span>
      <button class="city-preset hover:text-xorange font-bold transition" data-lng="139.7020" data-lat="35.6620" data-zoom="10">🇯🇵 東京 (179+)</button>
      <span>·</span>
      <button class="city-preset hover:text-xorange font-bold transition" data-lng="114.1694" data-lat="22.3193" data-zoom="11">🇭🇰 香港</button>
      <span>·</span>
      <button class="city-preset hover:text-xorange font-bold transition" data-lng="-118.2437" data-lat="34.0522" data-zoom="10">🇺🇸 加州</button>
      <span>·</span>
      <button class="city-preset hover:text-xorange font-bold transition" data-lng="151.2093" data-lat="-33.8688" data-zoom="10">🇦🇺 悉尼</button>
      <span>·</span>
      <button class="city-preset hover:text-xorange font-bold transition" data-lng="5.3698" data-lat="43.2965" data-zoom="11">🇫🇷 法國</button>
    </div>
  </div>

</div>

<script is:inline define:vars={{ mapboxToken, initialLat, initialLng, initialZoom, selectedCategory }}>
  let currentCategory = selectedCategory || 'ALL';
  let map;
  let allSpotsData = [];

  async function fetchGlobalSpots() {
    try {
      const res = await fetch('/data/global_spots.json');
      if (res.ok) {
        allSpotsData = await res.json();
        renderSpots();
      }
    } catch (e) {
      console.warn('Fallback spots loading:', e);
    }
  }

  function renderSpots() {
    if (!map || !map.getSource('spots-source')) return;

    const bounds = map.getBounds();
    const minLng = bounds.getWest();
    const minLat = bounds.getSouth();
    const maxLng = bounds.getEast();
    const maxLat = bounds.getNorth();

    const filtered = allSpotsData.filter((s) => {
      const inBbox = s.longitude >= minLng && s.longitude <= maxLng && s.latitude >= minLat && s.latitude <= maxLat;
      const matchesCat = currentCategory === 'ALL' || s.category === currentCategory;
      return inBbox && matchesCat;
    });

    const geojson = {
      type: 'FeatureCollection',
      features: filtered.map((s) => ({
        type: 'Feature',
        geometry: {
          type: 'Point',
          coordinates: [s.longitude, s.latitude],
        },
        properties: s,
      })),
    };

    map.getSource('spots-source').setData(geojson);

    const countEl = document.getElementById('spots-count');
    if (countEl) {
      countEl.innerText = filtered.length > 0 
        ? `${filtered.length} 個極限點位` 
        : `可視區內暫無點位 (可縮小地圖)`;
    }
  }

  function initMap() {
    if (typeof mapboxgl === 'undefined') {
      setTimeout(initMap, 200);
      return;
    }

    mapboxgl.accessToken = mapboxToken || 'pk.eyJ1IjoibGVvLWthaXQiLCJhIjoiY20wa3F6Z2YwMGV5bDJrczE1a2kyeG11dyJ9.E8y4kE5c9v8Z3c8w2v3q4w';

    map = new mapboxgl.Map({
      container: 'mapbox-container',
      style: 'mapbox://styles/mapbox/dark-v11',
      center: [initialLng, initialLat],
      zoom: initialZoom,
      attributionControl: false,
    });

    map.addControl(new mapboxgl.NavigationControl({ showCompass: true }), 'bottom-right');
    map.addControl(new mapboxgl.GeolocateControl({ positionOptions: { enableHighAccuracy: true }, trackUserLocation: true }), 'bottom-right');

    map.on('load', () => {
      map.addSource('spots-source', {
        type: 'geojson',
        data: { type: 'FeatureCollection', features: [] },
        cluster: true,
        clusterMaxZoom: 14,
        clusterRadius: 50,
      });

      map.addLayer({
        id: 'clusters',
        type: 'circle',
        source: 'spots-source',
        filter: ['has', 'point_count'],
        paint: {
          'circle-color': [
            'step',
            ['get', 'point_count'],
            '#ff5500', 10,
            '#f59e0b', 30,
            '#06b6d4', 75,
            '#a855f7'
          ],
          'circle-radius': [
            'step',
            ['get', 'point_count'],
            18, 10,
            24, 30,
            30, 75,
            36
          ],
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });

      map.addLayer({
        id: 'cluster-count',
        type: 'symbol',
        source: 'spots-source',
        filter: ['has', 'point_count'],
        layout: {
          'text-field': '{point_count_abbreviated}',
          'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
          'text-size': 12,
        },
        paint: {
          'text-color': '#ffffff',
        },
      });

      map.addLayer({
        id: 'unclustered-point',
        type: 'circle',
        source: 'spots-source',
        filter: ['!', ['has', 'point_count']],
        paint: {
          'circle-color': [
            'match',
            ['get', 'category'],
            'SKATE', '#ff5500',
            'CLIMB', '#10b981',
            'SURF', '#06b6d4',
            'BMX', '#a855f7',
            'SNOW', '#38bdf8',
            '#ff5500'
          ],
          'circle-radius': 8,
          'circle-stroke-width': 2,
          'circle-stroke-color': '#ffffff',
        },
      });

      map.on('click', 'clusters', (e) => {
        const features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
        const clusterId = features[0].properties.cluster_id;
        map.getSource('spots-source').getClusterExpansionZoom(clusterId, (err, zoom) => {
          if (err) return;
          map.easeTo({
            center: features[0].geometry.coordinates,
            zoom: zoom + 1,
            duration: 500,
          });
        });
      });

      fetchGlobalSpots();
      map.on('moveend', renderSpots);
    });
  }

  function startApp() {
    initMap();

    const catButtons = document.querySelectorAll('.cat-btn');
    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-cat');

        catButtons.forEach(b => {
          b.className = 'cat-btn px-3 py-1.5 rounded-xl text-xs font-bold uppercase tracking-wider text-gray-300 hover:text-white hover:bg-xcard transition-all';
        });
        btn.className = 'cat-btn px-3 py-1.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-200 bg-xorange text-white shadow-glow-orange';

        renderSpots();
      });
    });

    const presets = document.querySelectorAll('.city-preset');
    presets.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lng = parseFloat(btn.getAttribute('data-lng'));
        const lat = parseFloat(btn.getAttribute('data-lat'));
        const zoom = parseFloat(btn.getAttribute('data-zoom'));
        if (map) {
          map.flyTo({ center: [lng, lat], zoom: zoom, speed: 1.2 });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startApp);
  } else {
    startApp();
  }
</script>
