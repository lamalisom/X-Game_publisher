---
const categories = [
  { name: '🔥 全部焦點', href: '/' },
  { name: '🛹 滑板 SKATE', href: '/skate' },
  { name: '🚲 極限小輪 BMX', href: '/bmx' },
  { name: '🏄 衝浪 SURF', href: '/surf' },
  { name: '🧗 攀岩 CLIMB', href: '/climb' },
  { name: '🏂 單板 SNOW', href: '/snow' },
  { name: '🗓️ 賽事雷達', href: '/events' },
  { name: '📍 場地導覽', href: '/spots' },
  { name: '🛡️ 裝備與花式', href: '/tricks' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-xblack/90 border-b border-xborder/80">
  <!-- Top Ticker / Notification Bar -->
  <div class="bg-gradient-to-r from-xorange via-red-600 to-xorange text-white text-xs font-semibold py-1.5 px-4 tracking-wider uppercase flex items-center justify-between">
    <div class="flex items-center space-x-2 overflow-hidden whitespace-nowrap">
      <span class="bg-black/30 px-2 py-0.5 rounded text-[10px] font-black animate-pulse">LIVE RADAR</span>
      <span class="text-xs truncate">⚡ 2026 全球極限運動賽事雷達・選手專題・頂級場地導覽・Amazon 裝備直送</span>
    </div>
    <div class="hidden md:flex items-center space-x-3 text-xs">
      <a href="https://t.me/Una_next" target="_blank" rel="noopener noreferrer" class="hover:underline flex items-center gap-1 font-bold">
        <span>✈️ Telegram 頻道</span>
      </a>
      <span>|</span>
      <a href="/today" class="bg-black/40 hover:bg-black/60 px-2 py-0.5 rounded text-[11px] font-bold text-yellow-300">
        📱 IG Link in Bio
      </a>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-xorange to-red-600 flex items-center justify-center text-white font-black text-xl shadow-glow-orange group-hover:scale-105 transition-transform duration-200">
          X
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black tracking-tighter text-white uppercase italic">
            xGame <span class="text-xorange">Radar</span>
          </span>
          <span class="text-[10px] tracking-widest text-gray-400 uppercase font-mono -mt-1">
            Extreme Sports Magazine
          </span>
        </div>
      </a>

      <!-- Desktop Category Links -->
      <nav class="hidden lg:flex items-center space-x-1">
        {categories.slice(0, 7).map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 text-xs font-bold rounded-lg transition-all duration-150 ${
                isActive
                  ? 'bg-xorange text-white shadow-glow-orange'
                  : 'text-gray-300 hover:text-white hover:bg-xcard'
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-3">
        <a
          href="/today"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-yellow-500/40 bg-yellow-500/10 text-yellow-400 text-xs font-bold hover:bg-yellow-500/20 transition-colors"
        >
          <span>🔥 今日焦點</span>
        </a>
        <a
          href="https://t.me/Una_next"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-blue-600 to-sky-500 text-white text-xs font-extrabold shadow-md hover:brightness-110 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18.718-1.554 6.471-2.257 9.421-.297 1.25-.87 1.488-1.42 1.488-.57 0-1.02-.27-1.57-.63l-3.32-2.18-1.61 1.24c-.2.15-.38.28-.62.28-.35 0-.46-.22-.55-.58l-1.06-3.48-3.08-.96c-.67-.21-.68-.67.14-.99l12.06-4.65c.56-.21 1.05.13.88.87z"/>
          </svg>
          <span class="hidden sm:inline">加入 Telegram</span>
          <span class="sm:hidden">頻道</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Sub Nav Overflow for Mobile & Extra Categories -->
  <div class="border-t border-xborder/50 bg-xdark/80 px-4 py-2 overflow-x-auto scrollbar-none flex items-center space-x-2">
    {categories.map((item) => {
      const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
      return (
        <a
          href={item.href}
          class={`whitespace-nowrap px-2.5 py-1 text-xs rounded-md font-medium transition-colors ${
            isActive
              ? 'bg-xorange/20 text-xorange border border-xorange/40 font-bold'
              : 'text-gray-400 hover:text-gray-200 hover:bg-xcard'
          }`}
        >
          {item.name}
        </a>
      );
    })}
  </div>
</header>
