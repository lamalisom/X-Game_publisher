---
interface Props {
  status: 'UPCOMING' | 'LIVE' | 'COMPLETED';
  dates: string;
  tier?: string;
  location: string;
}

const { status, dates, tier = 'X-Game Major', location } = Astro.props;

const statusStyles = {
  UPCOMING: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  LIVE: 'bg-red-500/20 text-red-400 border-red-500/30 animate-pulse',
  COMPLETED: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'
};

const statusLabels = {
  UPCOMING: '🗓️ 未來賽事雷達',
  LIVE: '🔴 正在進行中 LIVE',
  COMPLETED: '🏆 賽事已完結・近期賽果'
};
---

<div class="rounded-xl bg-gradient-to-r from-xdark to-xcard border border-xborder p-4 my-4">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-xborder/50 pb-3 mb-3">
    <div class="flex items-center gap-2">
      <span class={`px-2.5 py-1 rounded-full text-xs font-black uppercase border ${statusStyles[status]}`}>
        {statusLabels[status]}
      </span>
      <span class="text-xs font-semibold text-yellow-400 bg-yellow-400/10 px-2 py-0.5 rounded border border-yellow-400/20">
        ⭐ {tier}
      </span>
    </div>
    <span class="text-xs font-mono text-gray-400">
      📍 {location}
    </span>
  </div>
  <div class="text-sm font-bold text-white flex items-center gap-2">
    <span>賽事日程：</span>
    <span class="text-xorange font-mono">{dates}</span>
  </div>
</div>
